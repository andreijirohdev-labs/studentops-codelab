{
  "git.alwaysSignOff": true,
  "java.project.sourcePaths": [
    "java/src"
  ],
  "java.project.referencedLibraries": [],
  "java.project.outputPath": "java/out",
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "java.debug.settings.onBuildFailureProceed": true,
  "gitlens.remotes": [{
    "domain": "altssh.gitlab.com",
    "name": "GitLab.com",
    "type": "GitLab",
    "urls": {
      "commit": "https://gitlab.com/${repo}"
    }
  }]
}